    </input>
    <output><fcd-output value="w20.fcd.xml"/></output>
    <fcd_device><device.fcd.period value="60"/></fcd_device>
    <time><begin value="72000"/><end value="75600"/><step-length value="1"/></time>
    <processing>
        <ignore-junction-blocker value="20"/>
