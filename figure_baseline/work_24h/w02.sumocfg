<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="/home/ngochieu/repo/dao_hieu/Lust_dataset/scenario/lust.net.xml"/>
        <route-files value="/home/ngochieu/repo/dao_hieu/figure_baseline/work_24h/w02__buslines.rou.xml,/home/ngochieu/repo/dao_hieu/figure_baseline/work_24h/w02__dua0.rou.xml,/home/ngochieu/repo/dao_hieu/figure_baseline/work_24h/w02__transit.rou.xml"/>
