<?xml version="1.0" encoding="UTF-8"?>
<!-- LuST 17:00-18:00 window (chỉ cửa sổ này, KHÔNG chạy 24h) -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="/home/ngochieu/repo/dao_hieu/Lust_dataset/scenario/lust.net.xml"/>
        <route-files value="window_buslines.rou.xml,window_DUARoutes_local.0.rou.xml,window_DUARoutes_local.1.rou.xml,window_DUARoutes_local.2.rou.xml,window_transit.rou.xml"/>
        <additional-files value="/home/ngochieu/repo/dao_hieu/Lust_dataset/scenario/vtypes.add.xml,/home/ngochieu/repo/dao_hieu/Lust_dataset/scenario/busstops.add.xml"/>
    </input>
    <output>
        <fcd-output value="window.fcd.xml"/>
    </output>
    <fcd_device>
        <device.fcd.period value="60"/>
    </fcd_device>
    <time>
        <begin value="61200"/>
        <end value="64800"/>
        <step-length value="1"/>
    </time>
    <processing>
        <ignore-junction-blocker value="20"/>
        <time-to-teleport value="600"/>
        <max-depart-delay value="600"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <verbose value="false"/>
    </report>
</configuration>
